<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Company>YuyuyuiPrivateServer</Company>
        <Product>GoalKeeper</Product>
        <VersionPrefix>0.1.0</VersionPrefix>
        <AssemblyVersion>$(Version)</AssemblyVersion>
        <FileVersion>$(Version)</FileVersion>
        <DebugType>embedded</DebugType>
        <TargetFramework>net6.0</TargetFramework>
        <LangVersion>latest</LangVersion>
    </PropertyGroup>

    <ItemGroup>
        <!-- DEV build (no RID): copy ALL runtimes to bin/ preserving structure -->
        <Content Include="runtimes/**" Condition="'$(RuntimeIdentifier)' == ''">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>Never</CopyToPublishDirectory>
        </Content>

        <!-- Publish with a RID: include ONLY that RID -->
        <Content Include="runtimes/$(RuntimeIdentifier)/native/**" Condition="'$(RuntimeIdentifier)' != ''">
            <CopyToPublishDirectory>Always</CopyToPublishDirectory>
            <CopyToOutputDirectory>Never</CopyToOutputDirectory>
            <TargetPath>runtimes/$(RuntimeIdentifier)/native/%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
        </Content>
    </ItemGroup>

</Project>
